{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:live": "vitest run --config vitest.live.config.mts",
    "eval:route": "vitest run --config vitest.live.config.mts src/server/live/route-eval.live.ts",
    "eval:cost": "vitest run --config vitest.live.config.mts src/server/live/cost-sample.live.ts",
    "eval:t16": "vitest run --config vitest.live.config.mts src/server/live/t16-reports.live.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.78",
    "@base-ui/react": "1.9.0",
    "@dagrejs/dagre": "3.1.3",
    "@xyflow/react": "12.12.0",
    "ai": "7.0.153",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "idb": "8.0.4",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-cjk-friendly": "2.3.3",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
