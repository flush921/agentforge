# LLM 接入模式：mock 使用模拟响应，live 调用 OpenAI 兼容中转站
LLM_MODE=mock

# live 模式必填；OpenAI 兼容 API 基础地址，真实地址只写入 .env.local
LLM_BASE_URL=https://your-relay.example.com/v1

# live 模式必填；请勿提交真实密钥
LLM_API_KEY=

# 模型名称；默认使用 deepseek-v4.1-flash
LLM_MODEL=deepseek-v4.1-flash

# 可选访问码；留空表示不启用访问码校验
ACCESS_CODE=

# Next 命令会自动管理；standalone 生产启动时使用 production
# NODE_ENV=production

# standalone 监听配置；默认端口 3000，默认监听 0.0.0.0
# PORT=3000
# HOSTNAME=0.0.0.0

# 可选 Node 启动参数；低内存生产环境可限制堆大小
# NODE_OPTIONS=--max-old-space-size=256
